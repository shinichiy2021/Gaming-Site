# Copy to .env and fill in values. Never commit .env.

# Helius / Triton / etc. HTTP RPC
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Matching WebSocket endpoint
WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Test hot wallet (Base58 secret key). Mainnet funds at risk — use a dedicated wallet.
WALLET_PRIVATE_KEY=

# Mid-price spread in basis points (20 = 0.20%)
GRID_SPREAD_BPS=20

# Size per side in SOL
ORDER_AMOUNT_SOL=0.1

# ComputeBudget priority fee (micro-lamports per CU)
PRIORITY_FEE_MICROLAMPORTS=50000

# Optional: compute unit limit (default 250000)
COMPUTE_UNIT_LIMIT=250000

# Loop interval in ms (rate-limit friendly)
LOOP_INTERVAL_MS=2000

# If true, claim seat / create ATAs when missing. Default: false (exit with guidance).
AUTO_CLAIM_SEAT=false

# Order lifetime in seconds (Phoenix lastValidUnixTimestamp)
ORDER_LIFETIME_SECONDS=30
