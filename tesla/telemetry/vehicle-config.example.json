{
  "hostname": "telemetry.shinichiy-gaming-hub.com",
  "port": 8443,
  "ca": "PASTE_PEM_FROM_tesla/telemetry/certs/ca.pem",
  "fields": {
    "Soc": { "interval_seconds": 300 },
    "BatteryLevel": { "interval_seconds": 300 },
    "EnergyRemaining": { "interval_seconds": 300 },
    "DetailedChargeState": { "interval_seconds": 60 },
    "ChargeAmps": { "interval_seconds": 60 },
    "ACChargingPower": { "interval_seconds": 60 },
    "DCChargingPower": { "interval_seconds": 60 },
    "ChargerVoltage": { "interval_seconds": 120 },
    "ChargeLimitSoc": { "interval_seconds": 300 },
    "ChargePortLatch": { "interval_seconds": 120 },
    "FastChargerPresent": { "interval_seconds": 120 },
    "TimeToFullCharge": { "interval_seconds": 120 },
    "EstBatteryRange": { "interval_seconds": 300 },
    "PackVoltage": { "interval_seconds": 120 },
    "PackCurrent": { "interval_seconds": 120 },
    "Gear": { "interval_seconds": 60 },
    "VehicleSpeed": { "interval_seconds": 60 },
    "HvacPower": { "interval_seconds": 120 },
    "LocatedAtHome": { "interval_seconds": 120 }
  }
