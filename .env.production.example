# Copy to .env on the production server: cp .env.production.example .env

MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-root-password

WP_HOME=https://shinichiy-gaming-hub.com
WP_SITEURL=https://shinichiy-gaming-hub.com

# EcoFlow (optional)
ECOFLOW_ACCESS_KEY=
ECOFLOW_SECRET_KEY=
ECOFLOW_DEVICE_SN=
ECOFLOW_DEVICE_SN_2=
ECOFLOW_APP_EMAIL=
ECOFLOW_APP_PASSWORD=
ECOFLOW_API_REGION=a

# SwitchBot Plug Mini (UPS AC watts)
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=
SWITCHBOT_UPS_DEVICE_ID=

# Tesla (optional)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_VEHICLE_VIN=
TESLA_REFRESH_TOKEN=
TESLA_FLEET_API_BASE_URL=https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_REDIRECT_URI=https://shinichiy-gaming-hub.com/wp-json/gaming-hub/v1/tesla/oauth/callback
TESLA_PARTNER_DOMAIN=shinichiy-gaming-hub.com

# Leave empty on production. This server is the source of truth for today Wh / yen.
GAMING_HUB_ENERGY_ORIGIN=
